---
/**
 * BadgeIcon - Achievement badge display
 */
import type { Badge } from '../../lib/wrapped-utils';

export interface Props {
  badge: Badge;
  className?: string;
}

const { badge, className = '' } = Astro.props;
---

<div class={`badge-item text-center p-6 rounded-2xl bg-white/10 backdrop-blur-sm ${className}`}>
  <div class="text-5xl mb-3">
    {badge.icon}
  </div>
  <div class="text-lg md:text-xl font-bold mb-2">
    {badge.name}
  </div>
  <div class="text-sm opacity-75">
    {badge.description}
  </div>
</div>
