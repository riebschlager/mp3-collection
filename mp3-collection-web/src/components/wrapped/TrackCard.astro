---
/**
 * TrackCard - Display a track with ranking, artist, and play count
 */
export interface Props {
  rank: number;
  track: string;
  artist: string;
  playCount: number;
  className?: string;
}

const { rank, track, artist, playCount, className = '' } = Astro.props;
---

<div class={`stagger-item flex items-center gap-4 p-4 rounded-lg bg-white/10 backdrop-blur-sm ${className}`}>
  <div class="text-3xl md:text-4xl font-bold opacity-50 min-w-[3rem] text-center">
    {rank}
  </div>
  <div class="flex-1 min-w-0">
    <div class="text-lg md:text-xl font-semibold truncate">
      {track}
    </div>
    <div class="text-sm md:text-base opacity-75 truncate">
      {artist}
    </div>
  </div>
  <div class="text-right">
    <div class="text-lg md:text-xl font-bold">
      {playCount}
    </div>
    <div class="text-xs opacity-75">
      plays
    </div>
  </div>
</div>
