---
/**
 * TopArtistSlide - Showcase #1 artist
 */
import { getTopArtists } from '../../../lib/wrapped-utils';
import type { Track } from '../../../lib/wrapped-utils';
import AlbumArt from '../AlbumArt.astro';

export interface Props {
  topTracks: Track[];
  topArtist?: {
    artist: string;
    count: number;
  };
}

const { topTracks, topArtist } = Astro.props;

const topArtists = getTopArtists(topTracks, 1);
const fallbackTopArtist = topArtists[0];
const topArtistName = topArtist?.artist || fallbackTopArtist?.artist || 'Unknown Artist';
const topArtistCount = typeof topArtist?.count === 'number'
  ? topArtist.count
  : fallbackTopArtist?.playCount || 0;

function normalizeArtistName(value: string): string {
  return value.toLowerCase().replace(/[^a-z0-9]+/g, '');
}

const topArtistTrack = topTracks.find((track) =>
  normalizeArtistName(track.artist) === normalizeArtistName(topArtistName)
)?.track;

const favoriteTrack = topArtist
  ? topArtistTrack || ''
  : topArtistTrack || fallbackTopArtist?.topTrack || topTracks[0]?.track || '';
---

<div class="slide-content text-center">
  <h2 class="text-2xl md:text-3xl font-medium mb-8 opacity-75">
    Your #1 Artist
  </h2>
  <div class="mb-8 flex flex-col items-center gap-6">
    <AlbumArt
      album={favoriteTrack}
      artist={topArtistName}
      size="xl"
      className="shadow-2xl"
    />
    <div class="text-6xl md:text-7xl lg:text-8xl font-bold">
      {topArtistName}
    </div>
    <div class="text-3xl md:text-4xl font-semibold opacity-90">
      {topArtistCount.toLocaleString()} plays
    </div>
  </div>
  {favoriteTrack && (
    <div class="mt-12 text-lg md:text-xl opacity-75">
      Your favorite: <span class="font-semibold">"{favoriteTrack}"</span>
    </div>
  )}
</div>
