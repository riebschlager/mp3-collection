---
/**
 * PatternSlide - Monthly listening patterns visualization
 */
import MonthlyChart from '../MonthlyChart.astro';
import { getPeakMonth, formatMonth } from '../../../lib/wrapped-utils';
import type { MonthData } from '../../../lib/wrapped-utils';

export interface Props {
  months: MonthData[];
}

const { months } = Astro.props;

const peakMonth = getPeakMonth(months);
const peakMonthName = peakMonth ? formatMonth(peakMonth.month) : '';
const peakScrobbles = peakMonth?.totalScrobbles || 0;
---

<div class="slide-content">
  <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center">
    Your Listening Pattern
  </h2>
  <MonthlyChart months={months} className="mb-8" />
  {peakMonth && (
    <div class="text-center mt-8">
      <div class="text-xl md:text-2xl opacity-75 mb-2">
        Your busiest month
      </div>
      <div class="text-3xl md:text-4xl font-bold">
        {peakMonthName}
      </div>
      <div class="text-lg md:text-xl opacity-75 mt-2">
        {peakScrobbles.toLocaleString()} scrobbles
      </div>
    </div>
  )}
</div>
