---
/**
 * PatternSlide - Monthly listening patterns visualization
 */
import MonthlyChart from '../MonthlyChart.astro';
import { getPeakMonth, formatMonth } from '../../../lib/wrapped-utils';
import type { MonthData } from '../../../lib/wrapped-utils';

export interface Props {
  months: MonthData[];
  nightPlayShare?: number;
  peakDay?: {
    date?: string;
    plays?: number;
  };
}

const { months, nightPlayShare, peakDay } = Astro.props;

const peakMonth = getPeakMonth(months);
const peakMonthName = peakMonth ? formatMonth(peakMonth.month) : '';
const peakScrobbles = peakMonth?.totalScrobbles || 0;
const nightSharePct = typeof nightPlayShare === 'number' ? Math.round(nightPlayShare * 100) : null;
const peakDayLabel = typeof peakDay?.date === 'string' ? peakDay.date : null;
const peakDayPlays = typeof peakDay?.plays === 'number' ? peakDay.plays : null;
---

<div class="slide-content">
  <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center">
    Your Listening Pattern
  </h2>
  <MonthlyChart months={months} className="mb-8" />
  {peakMonth && (
    <div class="text-center mt-8">
      <div class="text-xl md:text-2xl opacity-75 mb-2">
        Your busiest month
      </div>
      <div class="text-3xl md:text-4xl font-bold">
        {peakMonthName}
      </div>
      <div class="text-lg md:text-xl opacity-75 mt-2">
        {peakScrobbles.toLocaleString()} scrobbles
      </div>
    </div>
  )}
  {(nightSharePct !== null || (peakDayLabel && peakDayPlays !== null)) && (
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4 text-center">
      {nightSharePct !== null && (
        <div class="rounded-xl bg-white/10 p-4">
          <div class="text-sm opacity-75 mb-1">Late-night listening</div>
          <div class="text-2xl font-bold">{nightSharePct}%</div>
          <div class="text-sm opacity-75">of yearly plays (10pm-6am)</div>
        </div>
      )}
      {peakDayLabel && peakDayPlays !== null && (
        <div class="rounded-xl bg-white/10 p-4">
          <div class="text-sm opacity-75 mb-1">Peak day burst</div>
          <div class="text-2xl font-bold">{peakDayLabel}</div>
          <div class="text-sm opacity-75">{peakDayPlays.toLocaleString()} plays</div>
        </div>
      )}
    </div>
  )}
</div>
