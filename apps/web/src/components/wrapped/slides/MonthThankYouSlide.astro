---
/**
 * MonthThankYouSlide - Closing slide for monthly wrapped story
 */
import { buildUrl } from '../../../lib/urls';

export interface Props {
  monthLabel: string;
  year: number;
  totalScrobbles: number;
  uniqueTracks: number;
  prevMonth?: string;
  nextMonth?: string;
}

const { monthLabel, year, totalScrobbles, uniqueTracks, prevMonth, nextMonth } = Astro.props;

const prevHref = prevMonth ? buildUrl(`wrapped/monthly/${prevMonth.slice(0, 4)}/${prevMonth.slice(5, 7)}`) : '';
const nextHref = nextMonth ? buildUrl(`wrapped/monthly/${nextMonth.slice(0, 4)}/${nextMonth.slice(5, 7)}`) : '';
---

<div class="slide-content text-center">
  <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-8">
    {monthLabel}<br />wrapped up
  </h2>
  <div class="grid grid-cols-2 gap-6 max-w-md mx-auto mb-12">
    <div class="p-6 rounded-lg bg-white/10 backdrop-blur-sm">
      <div class="text-3xl md:text-4xl font-bold mb-2">
        {totalScrobbles.toLocaleString()}
      </div>
      <div class="text-sm opacity-75">
        Total Scrobbles
      </div>
    </div>
    <div class="p-6 rounded-lg bg-white/10 backdrop-blur-sm">
      <div class="text-3xl md:text-4xl font-bold mb-2">
        {uniqueTracks.toLocaleString()}
      </div>
      <div class="text-sm opacity-75">
        Unique Tracks
      </div>
    </div>
  </div>
  <div class="space-y-4">
    <div class="flex gap-4 justify-center flex-wrap">
      {prevMonth && (
        <a
          href={prevHref}
          class="inline-block px-6 py-3 rounded-full bg-white/20 backdrop-blur-sm font-medium hover:bg-white/30 transition-colors"
        >
          ← {prevMonth}
        </a>
      )}
      {nextMonth && (
        <a
          href={nextHref}
          class="inline-block px-8 py-4 rounded-full bg-white text-black font-bold text-lg hover:scale-105 transition-transform"
        >
          Explore {nextMonth} →
        </a>
      )}
    </div>
    <div class="flex gap-3 justify-center flex-wrap">
      <a
        href={buildUrl(`wrapped/${year}`)}
        class="inline-block px-6 py-3 rounded-full bg-white/20 backdrop-blur-sm font-medium hover:bg-white/30 transition-colors"
      >
        Back to {year} story
      </a>
      <a
        href={buildUrl('wrapped/monthly')}
        class="inline-block px-6 py-3 rounded-full bg-white/20 backdrop-blur-sm font-medium hover:bg-white/30 transition-colors"
      >
        All months
      </a>
    </div>
  </div>
</div>
