---
/**
 * BadgesSlide - Display achievement badges
 */
import BadgeIcon from '../BadgeIcon.astro';
import { getBadges } from '../../../lib/wrapped-utils';
import type { StoryCard, YearData } from '../../../lib/wrapped-utils';

export interface Props {
  yearData: YearData;
  storyCards?: StoryCard[];
}

const { yearData, storyCards = [] } = Astro.props;

const badges = getBadges(yearData);
const highlightCards = storyCards.slice(0, 4);
---

<div class="slide-content">
  <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center">
    Your Achievements
  </h2>
  {highlightCards.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {highlightCards.map((card) => (
        <div class="p-5 rounded-xl bg-white/10">
          <div class="text-xs uppercase tracking-wide opacity-70 mb-2">{card.title}</div>
          <div class="text-xl md:text-2xl font-bold mb-2">{card.headline}</div>
          <div class="text-sm md:text-base opacity-90">{card.detail}</div>
        </div>
      ))}
    </div>
  ) : badges.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {badges.map((badge) => (
        <BadgeIcon badge={badge} />
      ))}
    </div>
  ) : (
    <div class="text-center text-xl opacity-75">
      <p>Every listening journey is unique!</p>
      <p class="mt-4">Keep exploring music to unlock badges next year.</p>
    </div>
  )}
</div>
