---
/**
 * BigNumberSlide - Big number display for total listening time
 */
import StatCard from '../StatCard.astro';
import { getTotalMinutes, formatListeningTime } from '../../../lib/wrapped-utils';

export interface Props {
  totalScrobbles: number;
  totalMinutes?: number;
  activeDays?: number;
}

const { totalScrobbles, totalMinutes, activeDays } = Astro.props;

const computedTotalMinutes = typeof totalMinutes === 'number' && totalMinutes > 0
  ? Math.round(totalMinutes)
  : getTotalMinutes(totalScrobbles);
const formattedTime = formatListeningTime(computedTotalMinutes);
const avgPerActiveDay = typeof activeDays === 'number' && activeDays > 0
  ? Math.round(totalScrobbles / activeDays)
  : null;
const sublabel = avgPerActiveDay
  ? `That's ${computedTotalMinutes.toLocaleString()} minutes (${avgPerActiveDay} plays per active day).`
  : `That's ${computedTotalMinutes.toLocaleString()} minutes!`;
---

<div class="slide-content text-center">
  <h2 class="text-3xl md:text-4xl font-bold mb-12 opacity-90">
    You listened to
  </h2>
  <StatCard
    value={formattedTime}
    label="of music"
    sublabel={sublabel}
    size="lg"
  />
</div>
