---
/**
 * FunFactSlide - Display a fun fact about listening habits
 */
import { getFunFact } from '../../../lib/wrapped-utils';
import type { StoryCard, YearData } from '../../../lib/wrapped-utils';

export interface Props {
  yearData: YearData;
  insightBullets?: string[];
  storyCards?: StoryCard[];
}

const { yearData, insightBullets = [], storyCards = [] } = Astro.props;

const funFact = getFunFact(yearData);
const topInsights = insightBullets.slice(0, 3);
const featuredCard = storyCards.length > 0 ? storyCards[0] : null;
---

<div class="slide-content text-center">
  <div class="text-6xl mb-8">
    💡
  </div>
  <h2 class="text-3xl md:text-4xl font-bold mb-8">
    Fun Fact
  </h2>
  {topInsights.length > 0 ? (
    <div class="max-w-4xl mx-auto space-y-4 text-left">
      {topInsights.map((insight) => (
        <div class="rounded-2xl bg-white/10 p-5 text-lg md:text-2xl leading-relaxed">
          {insight}
        </div>
      ))}
      {featuredCard && (
        <div class="rounded-2xl bg-white/10 p-5 mt-6">
          <div class="text-sm uppercase tracking-wide opacity-75 mb-2">{featuredCard.title}</div>
          <div class="text-2xl md:text-3xl font-bold mb-2">{featuredCard.headline}</div>
          <div class="text-base md:text-lg opacity-90">{featuredCard.detail}</div>
        </div>
      )}
    </div>
  ) : (
    <p class="text-2xl md:text-3xl leading-relaxed">
      {funFact}
    </p>
  )}
</div>
