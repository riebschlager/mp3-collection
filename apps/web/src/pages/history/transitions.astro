---
import Layout from '../../layouts/Layout.astro';
import { buildUrl } from '../../lib/urls';

interface TransitionNode {
  id: string;
  label: string;
  artist?: string;
  track?: string;
  playCount: number;
  inDegree: number;
  outDegree: number;
  inWeight: number;
  outWeight: number;
}

interface TransitionEdge {
  source: string;
  target: string;
  sourceLabel: string;
  targetLabel: string;
  count: number;
  probability: number;
  avgGapMinutes: number;
  minGapMinutes: number;
  maxGapMinutes: number;
  firstSeen: number;
  lastSeen: number;
}

interface TransitionScopeData {
  summary: {
    totalDistinctNodes: number;
    nodesInGraph: number;
    isolatedNodes: number;
    totalEdges: number;
    edgesRetained: number;
    totalTransitions: number;
  };
  nodes: TransitionNode[];
  edges: TransitionEdge[];
}

interface TransitionArtifact {
  generatedAt: string;
  summary: {
    totalEvents: number;
    validEvents: number;
    skippedEvents: number;
    totalSessions: number;
    transitionsWithinSessions: number;
    transitionsAcrossSessionGap: number;
  };
  config: {
    sessionGapMinutes: number;
    minTransitionCount: number;
    maxEdgesPerScope: number;
    includeSelfLoops: boolean;
  };
  scopes: {
    track: TransitionScopeData;
    artist: TransitionScopeData;
  };
}

interface FlowTarget {
  label: string;
  count: number;
  share: number;
  avgGapMinutes: number;
}

interface FlowLadder {
  source: string;
  total: number;
  targets: FlowTarget[];
}

const transitionArtifact = await import('../../../public/data/transition-graph.json') as TransitionArtifact;

const emptyScope: TransitionScopeData = {
  summary: {
    totalDistinctNodes: 0,
    nodesInGraph: 0,
    isolatedNodes: 0,
    totalEdges: 0,
    edgesRetained: 0,
    totalTransitions: 0,
  },
  nodes: [],
  edges: [],
};

const trackScope = transitionArtifact.scopes?.track ?? emptyScope;
const artistScope = transitionArtifact.scopes?.artist ?? emptyScope;

const clamp = (value: number, min: number, max: number): number => Math.max(min, Math.min(max, value));

const compactScope = (scope: TransitionScopeData, edgeLimit: number, nodeLimit: number): TransitionScopeData => {
  const edgesByWeight = [...scope.edges].sort((a, b) => b.count - a.count);
  let edges = edgesByWeight.slice(0, edgeLimit);

  const nodeIds = new Set<string>();
  edges.forEach((edge) => {
    nodeIds.add(edge.source);
    nodeIds.add(edge.target);
  });

  let nodes = scope.nodes
    .filter((node) => nodeIds.has(node.id))
    .sort((a, b) => b.playCount - a.playCount);

  if (nodes.length > nodeLimit) {
    const keepNodeIds = new Set(nodes.slice(0, nodeLimit).map((node) => node.id));
    nodes = nodes.slice(0, nodeLimit);
    edges = edges.filter((edge) => keepNodeIds.has(edge.source) && keepNodeIds.has(edge.target));

    if (edges.length < edgeLimit) {
      for (const candidate of edgesByWeight.slice(edgeLimit)) {
        if (edges.length >= edgeLimit) break;
        if (!keepNodeIds.has(candidate.source) || !keepNodeIds.has(candidate.target)) continue;
        const exists = edges.some((edge) => edge.source === candidate.source && edge.target === candidate.target);
        if (!exists) edges.push(candidate);
      }
    }
  }

  edges.sort((a, b) => b.count - a.count);

  return {
    summary: scope.summary,
    nodes,
    edges,
  };
};

const buildFlowLadders = (scope: TransitionScopeData, sourceLimit: number, targetLimit: number): FlowLadder[] => {
  const grouped = new Map<string, { source: string; total: number; targets: Map<string, FlowTarget> }>();
  for (const edge of scope.edges) {
    const sourceKey = edge.source;
    const existing = grouped.get(sourceKey) ?? { source: edge.sourceLabel, total: 0, targets: new Map<string, FlowTarget>() };
    existing.total += edge.count;

    const target = existing.targets.get(edge.target) ?? {
      label: edge.targetLabel,
      count: 0,
      share: 0,
      avgGapMinutes: edge.avgGapMinutes,
    };
    target.count += edge.count;
    target.avgGapMinutes = edge.avgGapMinutes;
    existing.targets.set(edge.target, target);
    grouped.set(sourceKey, existing);
  }

  return [...grouped.values()]
    .sort((a, b) => b.total - a.total)
    .slice(0, sourceLimit)
    .map((group) => {
      const targets = [...group.targets.values()]
        .sort((a, b) => b.count - a.count)
        .slice(0, targetLimit)
        .map((target) => ({
          ...target,
          share: group.total > 0 ? clamp(target.count / group.total, 0, 1) : 0,
        }));
      return {
        source: group.source,
        total: group.total,
        targets,
      };
    });
};

const compactTrack = compactScope(trackScope, 280, 140);
const compactArtist = compactScope(artistScope, 240, 110);

const networkPayload = {
  track: compactTrack,
  artist: compactArtist,
};

const flowPayload = {
  track: buildFlowLadders(trackScope, 8, 5),
  artist: buildFlowLadders(artistScope, 8, 6),
};

const handoffPayload = {
  track: [...trackScope.edges].sort((a, b) => b.count - a.count).slice(0, 18),
  artist: [...artistScope.edges].sort((a, b) => b.count - a.count).slice(0, 18),
};

const combinedEdges = [...trackScope.edges, ...artistScope.edges];
const earliestEdge = combinedEdges.reduce((min, edge) => Math.min(min, edge.firstSeen), Number.POSITIVE_INFINITY);
const latestEdge = combinedEdges.reduce((max, edge) => Math.max(max, edge.lastSeen), 0);
const earliestYear = Number.isFinite(earliestEdge) ? new Date(earliestEdge).getUTCFullYear() : new Date().getUTCFullYear();
const latestYear = latestEdge > 0 ? new Date(latestEdge).getUTCFullYear() : earliestYear;
const fallbackYears = earliestYear <= latestYear ? [earliestYear, latestYear] : [earliestYear];
const defaultDataRoot = buildUrl('data');

const formatDate = (timestampMs: number): string => {
  if (!Number.isFinite(timestampMs) || timestampMs <= 0) return 'Unknown';
  return new Date(timestampMs).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---

<Layout title="Transition Flow Atlas - MP3 Collection">
  <div class="space-y-8">
    <div class="text-center">
      <h1 class="text-4xl font-bold text-gray-900 mb-3">Transition Flow Atlas</h1>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        Session-aware listening handoffs built from {transitionArtifact.summary.validEvents.toLocaleString()} valid events.
        Follow the next-song and next-artist paths to surface your strongest listening corridors.
      </p>
    </div>

    <div class="rounded-2xl bg-gradient-to-br from-slate-900 via-indigo-900 to-sky-900 text-white p-8 shadow-xl">
      <div class="flex flex-col lg:flex-row gap-6 lg:items-end lg:justify-between">
        <div class="space-y-3">
          <p class="text-xs uppercase tracking-[0.25em] text-sky-100/80">Flow Intelligence</p>
          <h2 class="text-3xl font-bold">What This Captures</h2>
          <p class="text-slate-100 max-w-3xl">
            A transition is counted when two consecutive listens occur within {transitionArtifact.config.sessionGapMinutes} minutes.
            This view excludes session breaks and keeps only the strongest edges for visual clarity.
          </p>
          <div class="text-sm text-slate-200">
            Time span: {formatDate(earliestEdge)} to {formatDate(latestEdge)}
          </div>
        </div>
        <a
          href={buildUrl('history')}
          class="inline-flex items-center justify-center rounded-full bg-white/15 px-6 py-3 text-sm font-semibold text-white hover:bg-white/25 transition-colors"
        >
          Back to History ->
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl shadow p-5">
        <div class="text-xs uppercase tracking-[0.2em] text-gray-500">Sessions</div>
        <div class="mt-2 text-3xl font-bold text-slate-900">{transitionArtifact.summary.totalSessions.toLocaleString()}</div>
        <div class="mt-1 text-sm text-gray-600">Boundaries defined by inactivity</div>
      </div>
      <div class="bg-white rounded-xl shadow p-5">
        <div class="text-xs uppercase tracking-[0.2em] text-gray-500">In-Session Transitions</div>
        <div class="mt-2 text-3xl font-bold text-indigo-700">{transitionArtifact.summary.transitionsWithinSessions.toLocaleString()}</div>
        <div class="mt-1 text-sm text-gray-600">Edges used to build this graph</div>
      </div>
      <div class="bg-white rounded-xl shadow p-5">
        <div class="text-xs uppercase tracking-[0.2em] text-gray-500">Track Edges</div>
        <div class="mt-2 text-3xl font-bold text-fuchsia-700">{trackScope.summary.totalEdges.toLocaleString()}</div>
        <div class="mt-1 text-sm text-gray-600">Distinct track-to-track handoffs</div>
      </div>
      <div class="bg-white rounded-xl shadow p-5">
        <div class="text-xs uppercase tracking-[0.2em] text-gray-500">Artist Edges</div>
        <div class="mt-2 text-3xl font-bold text-cyan-700">{artistScope.summary.totalEdges.toLocaleString()}</div>
        <div class="mt-1 text-sm text-gray-600">Distinct artist-to-artist handoffs</div>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow p-6">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
        <div>
          <h2 class="text-2xl font-bold text-gray-900">Query Controls</h2>
          <p class="text-sm text-gray-600 mt-1">
            Source and year-range controls are powered by MCP `music_transition_graph` slices.
          </p>
        </div>
        <div class="text-sm text-slate-600" id="query-range-label">
          Showing full-range fallback slice.
        </div>
      </div>

      <div class="mt-5 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-3">
        <label class="text-sm">
          <span class="block font-semibold text-slate-700 mb-1">Source</span>
          <select id="source-filter" class="w-full rounded-lg border border-slate-300 px-3 py-2 bg-white text-slate-800">
            <option value="all">All Sources</option>
            <option value="lastfm">Last.fm</option>
            <option value="spotify">Spotify</option>
          </select>
        </label>
        <label class="text-sm">
          <span class="block font-semibold text-slate-700 mb-1">Start Year</span>
          <select id="start-year-filter" class="w-full rounded-lg border border-slate-300 px-3 py-2 bg-white text-slate-800"></select>
        </label>
        <label class="text-sm">
          <span class="block font-semibold text-slate-700 mb-1">End Year</span>
          <select id="end-year-filter" class="w-full rounded-lg border border-slate-300 px-3 py-2 bg-white text-slate-800"></select>
        </label>
        <div class="flex items-end">
          <button id="apply-query-btn" type="button" class="w-full rounded-lg bg-slate-900 text-white px-4 py-2.5 font-semibold hover:bg-slate-800 transition-colors">
            Apply Query
          </button>
        </div>
        <div class="flex items-end">
          <button id="reset-query-btn" type="button" class="w-full rounded-lg border border-slate-300 bg-white text-slate-700 px-4 py-2.5 font-semibold hover:bg-slate-50 transition-colors">
            Reset
          </button>
        </div>
      </div>

      <div id="query-status" class="mt-4 rounded-lg border border-sky-200 bg-sky-50 px-3 py-2 text-sm text-sky-800">
        Loading MCP query cache...
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow p-6">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-5">
        <div>
          <h2 class="text-2xl font-bold text-gray-900">Transition Network</h2>
          <p class="text-sm text-gray-600" id="network-caption">Weighted directional graph of your strongest handoffs.</p>
        </div>
        <div class="inline-flex rounded-full bg-gray-100 p-1 shadow-inner">
          <button type="button" data-scope="track" class="scope-btn rounded-full px-4 py-2 text-sm font-semibold transition-colors">
            Track Flow
          </button>
          <button type="button" data-scope="artist" class="scope-btn rounded-full px-4 py-2 text-sm font-semibold transition-colors">
            Artist Flow
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <div class="lg:col-span-3 rounded-xl border border-slate-200 bg-slate-950/95 p-3">
          <svg id="transition-network" viewBox="0 0 1000 620" class="w-full h-[460px] md:h-[620px] rounded-lg"></svg>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-4 bg-slate-50">
            <h3 class="text-sm uppercase tracking-[0.18em] text-slate-600">Current Scope</h3>
            <div class="mt-3 text-lg font-bold text-slate-900" id="scope-name">Track</div>
            <div class="mt-2 text-sm text-slate-700">
              <div>Nodes: <span id="scope-nodes" class="font-semibold"></span></div>
              <div>Edges: <span id="scope-edges" class="font-semibold"></span></div>
              <div>Transitions: <span id="scope-transitions" class="font-semibold"></span></div>
            </div>
          </div>
          <div id="network-details" class="rounded-xl border border-indigo-200 bg-indigo-50 p-4 text-sm text-indigo-900">
            Click a node to inspect incoming and outgoing handoffs.
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow p-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-2">Sankey Ladders</h2>
      <p class="text-sm text-gray-600 mb-5">
        Top source nodes and where they hand off next. Bars represent share of outbound transitions.
      </p>
      <div id="flow-ladders" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4"></div>
    </div>

    <div class="bg-white rounded-2xl shadow p-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-2">Top Handoffs</h2>
      <p class="text-sm text-gray-600 mb-5">
        Highest-volume directional transitions with conditional probability and average gap.
      </p>
      <div id="top-handoffs" class="space-y-2"></div>
    </div>
  </div>

  <script
    is:inline
    define:vars={{ networkPayload, flowPayload, handoffPayload, fallbackYears, defaultDataRoot }}
  >
    const svg = document.getElementById('transition-network');
    const flowLaddersEl = document.getElementById('flow-ladders');
    const topHandoffsEl = document.getElementById('top-handoffs');
    const detailsEl = document.getElementById('network-details');
    const captionEl = document.getElementById('network-caption');
    const scopeNameEl = document.getElementById('scope-name');
    const scopeNodesEl = document.getElementById('scope-nodes');
    const scopeEdgesEl = document.getElementById('scope-edges');
    const scopeTransitionsEl = document.getElementById('scope-transitions');
    const scopeButtons = Array.from(document.querySelectorAll('.scope-btn'));

    const sourceFilterEl = document.getElementById('source-filter');
    const startYearEl = document.getElementById('start-year-filter');
    const endYearEl = document.getElementById('end-year-filter');
    const applyQueryEl = document.getElementById('apply-query-btn');
    const resetQueryEl = document.getElementById('reset-query-btn');
    const queryStatusEl = document.getElementById('query-status');
    const queryRangeLabelEl = document.getElementById('query-range-label');

    const scopeMeta = {
      track: {
        name: 'Track',
        edgeColor: '#c026d3',
        nodeColor: '#f472b6',
        gradient: 'linear-gradient(90deg, #d946ef 0%, #8b5cf6 100%)',
      },
      artist: {
        name: 'Artist',
        edgeColor: '#0891b2',
        nodeColor: '#22d3ee',
        gradient: 'linear-gradient(90deg, #06b6d4 0%, #0ea5e9 100%)',
      },
    };

    const sourceLabels = {
      all: 'All Sources',
      lastfm: 'Last.fm',
      spotify: 'Spotify',
    };

    const NS = 'http://www.w3.org/2000/svg';
    let currentScope = 'track';
    let selectedNodeId = '';

    const normalizeFallbackYears = () => {
      if (!Array.isArray(fallbackYears) || fallbackYears.length === 0) {
        const y = new Date().getUTCFullYear();
        return [y];
      }
      if (fallbackYears.length === 1) {
        return [Number(fallbackYears[0])];
      }
      const a = Number(fallbackYears[0]);
      const b = Number(fallbackYears[1]);
      const start = Number.isFinite(a) ? a : new Date().getUTCFullYear();
      const end = Number.isFinite(b) ? b : start;
      return start <= end ? [start, end] : [end, start];
    };

    const fallbackYearBounds = normalizeFallbackYears();
    const fallbackYearMin = fallbackYearBounds[0];
    const fallbackYearMax = fallbackYearBounds[fallbackYearBounds.length - 1];

    let activeNetworkPayload = networkPayload;
    let activeFlowPayload = flowPayload;
    let activeHandoffPayload = handoffPayload;

    let availableYears = [];
    for (let year = fallbackYearMin; year <= fallbackYearMax; year += 1) {
      availableYears.push(year);
    }
    if (availableYears.length === 0) {
      availableYears = [fallbackYearMin];
    }
    let availableSources = ['all'];
    let selectedSource = 'all';
    let selectedStartYear = availableYears[0];
    let selectedEndYear = availableYears[availableYears.length - 1];
    let querySlices = null;

    const toNumber = (value, fallback = 0) => {
      const num = Number(value);
      return Number.isFinite(num) ? num : fallback;
    };

    const clamp = (value, min, max) => Math.max(min, Math.min(max, value));

    const escapeHtml = (value) => String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');

    const hashCode = (value) => {
      let hash = 0;
      for (let i = 0; i < value.length; i += 1) {
        hash = ((hash << 5) - hash) + value.charCodeAt(i);
        hash |= 0;
      }
      return Math.abs(hash);
    };

    const compactScope = (scope, edgeLimit, nodeLimit) => {
      const edgesByWeight = [...(scope.edges || [])].sort((a, b) => toNumber(b.count) - toNumber(a.count));
      let edges = edgesByWeight.slice(0, edgeLimit);

      const nodeIds = new Set();
      edges.forEach((edge) => {
        nodeIds.add(edge.source);
        nodeIds.add(edge.target);
      });

      let nodes = [...(scope.nodes || [])]
        .filter((node) => nodeIds.has(node.id))
        .sort((a, b) => toNumber(b.playCount) - toNumber(a.playCount));

      if (nodes.length > nodeLimit) {
        const keepNodeIds = new Set(nodes.slice(0, nodeLimit).map((node) => node.id));
        nodes = nodes.slice(0, nodeLimit);
        edges = edges.filter((edge) => keepNodeIds.has(edge.source) && keepNodeIds.has(edge.target));
      }

      const uniqueNodeIds = new Set();
      edges.forEach((edge) => {
        uniqueNodeIds.add(edge.source);
        uniqueNodeIds.add(edge.target);
      });

      return {
        summary: {
          ...(scope.summary || {}),
          edgesRetained: edges.length,
          nodesInGraph: uniqueNodeIds.size,
        },
        nodes,
        edges,
      };
    };

    const buildFlowLaddersFromScope = (scope, sourceLimit, targetLimit) => {
      const grouped = new Map();
      for (const edge of scope.edges || []) {
        const sourceKey = edge.source;
        const existing = grouped.get(sourceKey) || { source: edge.sourceLabel, total: 0, targets: new Map() };
        existing.total += toNumber(edge.count);

        const target = existing.targets.get(edge.target) || {
          label: edge.targetLabel,
          count: 0,
          share: 0,
          avgGapMinutes: toNumber(edge.avgGapMinutes),
        };
        target.count += toNumber(edge.count);
        target.avgGapMinutes = toNumber(edge.avgGapMinutes);
        existing.targets.set(edge.target, target);
        grouped.set(sourceKey, existing);
      }

      return [...grouped.values()]
        .sort((a, b) => b.total - a.total)
        .slice(0, sourceLimit)
        .map((group) => ({
          source: group.source,
          total: group.total,
          targets: [...group.targets.values()]
            .sort((a, b) => b.count - a.count)
            .slice(0, targetLimit)
            .map((target) => ({
              ...target,
              share: group.total > 0 ? clamp(target.count / group.total, 0, 1) : 0,
            })),
        }));
    };

    const buildScopeFromSlices = (scopeName, slices) => {
      const edgeMap = new Map();
      const nodeMap = new Map();
      let totalTransitions = 0;

      slices.forEach((slice) => {
        const scope = slice?.graphs?.[scopeName];
        if (!scope) return;

        totalTransitions += toNumber(scope.summary?.totalTransitions);

        for (const rawNode of scope.nodes || []) {
          const nodeId = String(rawNode.id || '');
          if (!nodeId) continue;
          const existing = nodeMap.get(nodeId) || {
            id: nodeId,
            label: rawNode.label || nodeId,
            artist: rawNode.artist || '',
            track: rawNode.track || '',
            playCount: 0,
            inDegree: 0,
            outDegree: 0,
            inWeight: 0,
            outWeight: 0,
          };
          existing.playCount += toNumber(rawNode.playCount);
          if (!existing.label && rawNode.label) existing.label = rawNode.label;
          if (!existing.artist && rawNode.artist) existing.artist = rawNode.artist;
          if (!existing.track && rawNode.track) existing.track = rawNode.track;
          nodeMap.set(nodeId, existing);
        }

        for (const rawEdge of scope.edges || []) {
          const source = String(rawEdge.source || '');
          const target = String(rawEdge.target || '');
          if (!source || !target) continue;
          const count = toNumber(rawEdge.count);
          if (count <= 0) continue;

          const key = `${source}>>${target}`;
          const existing = edgeMap.get(key) || {
            source,
            target,
            sourceLabel: rawEdge.sourceLabel || source,
            targetLabel: rawEdge.targetLabel || target,
            count: 0,
            avgGapMinutes: 0,
            minGapMinutes: Number.POSITIVE_INFINITY,
            maxGapMinutes: 0,
            firstSeen: Number.POSITIVE_INFINITY,
            lastSeen: 0,
            _gapWeight: 0,
          };

          const avgGap = toNumber(rawEdge.avgGapMinutes);
          existing.count += count;
          existing._gapWeight += avgGap * count;
          existing.minGapMinutes = Math.min(existing.minGapMinutes, toNumber(rawEdge.minGapMinutes, avgGap));
          existing.maxGapMinutes = Math.max(existing.maxGapMinutes, toNumber(rawEdge.maxGapMinutes, avgGap));
          existing.firstSeen = Math.min(existing.firstSeen, toNumber(rawEdge.firstSeen, Number.POSITIVE_INFINITY));
          existing.lastSeen = Math.max(existing.lastSeen, toNumber(rawEdge.lastSeen, 0));
          if (!existing.sourceLabel && rawEdge.sourceLabel) existing.sourceLabel = rawEdge.sourceLabel;
          if (!existing.targetLabel && rawEdge.targetLabel) existing.targetLabel = rawEdge.targetLabel;

          edgeMap.set(key, existing);
        }
      });

      const outgoingTotals = new Map();
      const nodesInGraphIds = new Set();
      const edges = [...edgeMap.values()]
        .map((edge) => {
          const outTotal = outgoingTotals.get(edge.source) || 0;
          outgoingTotals.set(edge.source, outTotal + edge.count);
          return edge;
        });

      edges.forEach((edge) => {
        nodesInGraphIds.add(edge.source);
        nodesInGraphIds.add(edge.target);

        const sourceNode = nodeMap.get(edge.source) || {
          id: edge.source,
          label: edge.sourceLabel || edge.source,
          artist: '',
          track: '',
          playCount: 0,
          inDegree: 0,
          outDegree: 0,
          inWeight: 0,
          outWeight: 0,
        };
        const targetNode = nodeMap.get(edge.target) || {
          id: edge.target,
          label: edge.targetLabel || edge.target,
          artist: '',
          track: '',
          playCount: 0,
          inDegree: 0,
          outDegree: 0,
          inWeight: 0,
          outWeight: 0,
        };

        sourceNode.outDegree += 1;
        sourceNode.outWeight += edge.count;
        targetNode.inDegree += 1;
        targetNode.inWeight += edge.count;
        if (!sourceNode.playCount) sourceNode.playCount = sourceNode.outWeight + sourceNode.inWeight;
        if (!targetNode.playCount) targetNode.playCount = targetNode.outWeight + targetNode.inWeight;
        nodeMap.set(edge.source, sourceNode);
        nodeMap.set(edge.target, targetNode);
      });

      const normalizedEdges = edges
        .map((edge) => {
          const outTotal = outgoingTotals.get(edge.source) || 0;
          const avgGap = edge.count > 0 ? edge._gapWeight / edge.count : 0;
          return {
            source: edge.source,
            target: edge.target,
            sourceLabel: edge.sourceLabel || edge.source,
            targetLabel: edge.targetLabel || edge.target,
            count: edge.count,
            probability: outTotal > 0 ? edge.count / outTotal : 0,
            avgGapMinutes: avgGap,
            minGapMinutes: Number.isFinite(edge.minGapMinutes) ? edge.minGapMinutes : avgGap,
            maxGapMinutes: edge.maxGapMinutes,
            firstSeen: Number.isFinite(edge.firstSeen) ? edge.firstSeen : 0,
            lastSeen: edge.lastSeen,
          };
        })
        .sort((a, b) => b.count - a.count);

      const nodes = [...nodeMap.values()]
        .filter((node) => nodesInGraphIds.has(node.id))
        .sort((a, b) => b.playCount - a.playCount);

      if (totalTransitions === 0) {
        totalTransitions = normalizedEdges.reduce((sum, edge) => sum + toNumber(edge.count), 0);
      }

      return {
        summary: {
          totalDistinctNodes: nodeMap.size,
          nodesInGraph: nodes.length,
          isolatedNodes: Math.max(0, nodeMap.size - nodes.length),
          totalEdges: normalizedEdges.length,
          edgesRetained: normalizedEdges.length,
          totalTransitions,
        },
        nodes,
        edges: normalizedEdges,
      };
    };

    const buildDatasetFromSlices = (slices) => {
      const trackRaw = buildScopeFromSlices('track', slices);
      const artistRaw = buildScopeFromSlices('artist', slices);
      const track = compactScope(trackRaw, 280, 140);
      const artist = compactScope(artistRaw, 240, 110);
      return {
        network: { track, artist },
        flow: {
          track: buildFlowLaddersFromScope(trackRaw, 8, 5),
          artist: buildFlowLaddersFromScope(artistRaw, 8, 6),
        },
        handoffs: {
          track: [...trackRaw.edges].slice(0, 18),
          artist: [...artistRaw.edges].slice(0, 18),
        },
      };
    };

    const setScopeButtonState = () => {
      scopeButtons.forEach((button) => {
        const scope = button.getAttribute('data-scope');
        const active = scope === currentScope;
        button.classList.toggle('bg-white', active);
        button.classList.toggle('text-slate-900', active);
        button.classList.toggle('shadow', active);
        button.classList.toggle('text-slate-500', !active);
      });
    };

    const updateScopeSummary = () => {
      const scopeData = activeNetworkPayload[currentScope];
      const summary = scopeData?.summary ?? {};
      const meta = scopeMeta[currentScope];
      if (scopeNameEl) scopeNameEl.textContent = meta.name;
      if (scopeNodesEl) scopeNodesEl.textContent = Number(summary.nodesInGraph || 0).toLocaleString();
      if (scopeEdgesEl) scopeEdgesEl.textContent = Number(summary.edgesRetained || 0).toLocaleString();
      if (scopeTransitionsEl) scopeTransitionsEl.textContent = Number(summary.totalTransitions || 0).toLocaleString();

      const sourceLabel = sourceLabels[selectedSource] || selectedSource;
      if (captionEl) {
        captionEl.textContent = `${meta.name}-to-${meta.name.toLowerCase()} flow for ${sourceLabel}, ${selectedStartYear}-${selectedEndYear}.`;
      }
    };

    const buildLayout = (nodes) => {
      const ranked = [...nodes].sort((a, b) => ((b.inWeight + b.outWeight) - (a.inWeight + a.outWeight)));
      const bands = [
        ranked.slice(0, 10),
        ranked.slice(10, 34),
        ranked.slice(34, 76),
        ranked.slice(76),
      ];
      const radii = [110, 200, 285, 370];
      const center = { x: 500, y: 310 };
      const positions = new Map();

      bands.forEach((band, bandIndex) => {
        const total = band.length || 1;
        band.forEach((node, i) => {
          const angleBase = (Math.PI * 2 * i) / total;
          const jitter = ((hashCode(node.id) % 28) - 14) * 0.015;
          const angle = angleBase + jitter;
          const radiusJitter = ((hashCode(`${node.id}-r`) % 24) - 12);
          const radius = radii[bandIndex] + radiusJitter;
          positions.set(node.id, {
            x: center.x + Math.cos(angle) * radius,
            y: center.y + Math.sin(angle) * radius,
          });
        });
      });

      return { positions, ranked };
    };

    const renderDetails = () => {
      if (!detailsEl) return;
      if (!selectedNodeId) {
        detailsEl.innerHTML = 'Click a node to inspect incoming and outgoing handoffs.';
        return;
      }

      const scopeData = activeNetworkPayload[currentScope];
      const node = (scopeData.nodes || []).find((entry) => entry.id === selectedNodeId);
      if (!node) {
        detailsEl.innerHTML = 'Click a node to inspect incoming and outgoing handoffs.';
        return;
      }

      const outgoing = (scopeData.edges || [])
        .filter((edge) => edge.source === selectedNodeId)
        .sort((a, b) => toNumber(b.count) - toNumber(a.count))
        .slice(0, 4);
      const incoming = (scopeData.edges || [])
        .filter((edge) => edge.target === selectedNodeId)
        .sort((a, b) => toNumber(b.count) - toNumber(a.count))
        .slice(0, 4);

      const outgoingHtml = outgoing.length
        ? outgoing.map((edge) => `<li>${escapeHtml(edge.targetLabel)} <span class="font-semibold text-slate-900">(${toNumber(edge.count).toLocaleString()})</span></li>`).join('')
        : '<li>No outgoing transitions in this slice.</li>';
      const incomingHtml = incoming.length
        ? incoming.map((edge) => `<li>${escapeHtml(edge.sourceLabel)} <span class="font-semibold text-slate-900">(${toNumber(edge.count).toLocaleString()})</span></li>`).join('')
        : '<li>No incoming transitions in this slice.</li>';

      detailsEl.innerHTML = `
        <div class="space-y-2">
          <div class="font-bold text-indigo-950">${escapeHtml(node.label)}</div>
          <div class="text-xs uppercase tracking-[0.12em] text-indigo-700">Play count ${toNumber(node.playCount).toLocaleString()}</div>
          <div class="pt-1">
            <div class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Outgoing</div>
            <ul class="mt-1 space-y-1 text-slate-700">${outgoingHtml}</ul>
          </div>
          <div class="pt-1">
            <div class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Incoming</div>
            <ul class="mt-1 space-y-1 text-slate-700">${incomingHtml}</ul>
          </div>
        </div>
      `;
    };

    const renderNetwork = () => {
      if (!(svg instanceof SVGElement)) return;
      const scopeData = activeNetworkPayload[currentScope];
      const meta = scopeMeta[currentScope];
      const nodes = scopeData.nodes || [];
      const edges = scopeData.edges || [];

      svg.innerHTML = '';
      if (nodes.length === 0 || edges.length === 0) {
        const empty = document.createElementNS(NS, 'text');
        empty.setAttribute('x', '500');
        empty.setAttribute('y', '310');
        empty.setAttribute('text-anchor', 'middle');
        empty.setAttribute('fill', '#cbd5e1');
        empty.setAttribute('font-size', '18');
        empty.setAttribute('font-family', 'ui-sans-serif, system-ui, sans-serif');
        empty.textContent = 'No transitions for the selected source and year range.';
        svg.appendChild(empty);
        return;
      }

      const maxEdgeCount = Math.max(1, ...edges.map((edge) => toNumber(edge.count)));
      const maxPlayCount = Math.max(1, ...nodes.map((node) => toNumber(node.playCount)));
      const { positions, ranked } = buildLayout(nodes);

      const edgeLayer = document.createElementNS(NS, 'g');
      const nodeLayer = document.createElementNS(NS, 'g');
      const labelLayer = document.createElementNS(NS, 'g');

      edges.forEach((edge) => {
        const sourcePos = positions.get(edge.source);
        const targetPos = positions.get(edge.target);
        if (!sourcePos || !targetPos) return;

        const edgeCount = toNumber(edge.count);
        const isInSelection = !selectedNodeId || edge.source === selectedNodeId || edge.target === selectedNodeId;
        const line = document.createElementNS(NS, 'line');
        line.setAttribute('x1', String(sourcePos.x));
        line.setAttribute('y1', String(sourcePos.y));
        line.setAttribute('x2', String(targetPos.x));
        line.setAttribute('y2', String(targetPos.y));
        line.setAttribute('stroke', meta.edgeColor);
        line.setAttribute('stroke-opacity', isInSelection ? String(0.2 + (edgeCount / maxEdgeCount) * 0.65) : '0.04');
        line.setAttribute('stroke-width', String(0.5 + (edgeCount / maxEdgeCount) * 7.5));
        line.setAttribute('stroke-linecap', 'round');
        line.innerHTML = `<title>${escapeHtml(edge.sourceLabel)} -> ${escapeHtml(edge.targetLabel)} | ${edgeCount.toLocaleString()} plays | ${(toNumber(edge.probability) * 100).toFixed(1)}%</title>`;
        edgeLayer.appendChild(line);
      });

      const labelSet = new Set(ranked.slice(0, 18).map((node) => node.id));
      if (selectedNodeId) {
        labelSet.add(selectedNodeId);
        edges.forEach((edge) => {
          if (edge.source === selectedNodeId || edge.target === selectedNodeId) {
            labelSet.add(edge.source);
            labelSet.add(edge.target);
          }
        });
      }

      nodes.forEach((node) => {
        const position = positions.get(node.id);
        if (!position) return;
        const isSelected = selectedNodeId === node.id;
        const isRelated = !selectedNodeId
          || isSelected
          || edges.some((edge) =>
            (edge.source === selectedNodeId && edge.target === node.id) ||
            (edge.target === selectedNodeId && edge.source === node.id)
          );

        const circle = document.createElementNS(NS, 'circle');
        circle.setAttribute('cx', String(position.x));
        circle.setAttribute('cy', String(position.y));
        circle.setAttribute('r', String(3 + Math.sqrt(toNumber(node.playCount) / maxPlayCount) * 13));
        circle.setAttribute('fill', meta.nodeColor);
        circle.setAttribute('fill-opacity', isRelated ? '0.95' : '0.28');
        circle.setAttribute('stroke', '#ffffff');
        circle.setAttribute('stroke-width', isSelected ? '2.4' : '0.9');
        circle.style.cursor = 'pointer';
        circle.innerHTML = `<title>${escapeHtml(node.label)} | plays ${toNumber(node.playCount).toLocaleString()} | out ${toNumber(node.outWeight).toLocaleString()} | in ${toNumber(node.inWeight).toLocaleString()}</title>`;
        circle.addEventListener('click', (event) => {
          event.stopPropagation();
          selectedNodeId = selectedNodeId === node.id ? '' : node.id;
          renderDetails();
          renderNetwork();
        });
        nodeLayer.appendChild(circle);

        if (labelSet.has(node.id)) {
          const text = document.createElementNS(NS, 'text');
          text.setAttribute('x', String(position.x + 8));
          text.setAttribute('y', String(position.y + 3));
          text.setAttribute('font-size', '11');
          text.setAttribute('font-family', 'ui-sans-serif, system-ui, sans-serif');
          text.setAttribute('fill', '#e2e8f0');
          text.setAttribute('fill-opacity', isRelated ? '0.95' : '0.42');
          const label = String(node.label || '');
          text.textContent = label.length > 34 ? `${label.slice(0, 34)}...` : label;
          labelLayer.appendChild(text);
        }
      });

      svg.onclick = () => {
        if (!selectedNodeId) return;
        selectedNodeId = '';
        renderDetails();
        renderNetwork();
      };

      svg.appendChild(edgeLayer);
      svg.appendChild(nodeLayer);
      svg.appendChild(labelLayer);
    };

    const renderFlowLadders = () => {
      if (!flowLaddersEl) return;
      const meta = scopeMeta[currentScope];
      const ladders = activeFlowPayload[currentScope] || [];
      flowLaddersEl.innerHTML = '';

      ladders.forEach((ladder) => {
        const card = document.createElement('article');
        card.className = 'rounded-xl border border-slate-200 p-4 bg-slate-50';
        const rows = (ladder.targets || []).map((target) => `
          <div class="space-y-1">
            <div class="flex items-center justify-between gap-3 text-sm">
              <span class="truncate text-slate-700">${escapeHtml(target.label)}</span>
              <span class="font-semibold text-slate-900">${toNumber(target.count).toLocaleString()}</span>
            </div>
            <div class="h-2 rounded-full bg-slate-200 overflow-hidden">
              <div class="h-full" style="width: ${(toNumber(target.share) * 100).toFixed(1)}%; background: ${meta.gradient};"></div>
            </div>
          </div>
        `).join('');

        card.innerHTML = `
          <header class="mb-3 flex items-center justify-between gap-3">
            <h3 class="font-semibold text-slate-900 truncate">${escapeHtml(ladder.source)}</h3>
            <span class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">${toNumber(ladder.total).toLocaleString()} out</span>
          </header>
          <div class="space-y-3">${rows}</div>
        `;
        flowLaddersEl.appendChild(card);
      });
    };

    const renderTopHandoffs = () => {
      if (!topHandoffsEl) return;
      const handoffs = activeHandoffPayload[currentScope] || [];
      topHandoffsEl.innerHTML = handoffs.map((edge, idx) => `
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3">
          <div class="flex items-start gap-3 min-w-0">
            <span class="mt-0.5 inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-900 text-white text-xs font-bold">${idx + 1}</span>
            <div class="min-w-0">
              <div class="font-medium text-slate-900 truncate">${escapeHtml(edge.sourceLabel)} -> ${escapeHtml(edge.targetLabel)}</div>
              <div class="text-xs text-slate-500">Avg gap ${toNumber(edge.avgGapMinutes).toFixed(2)} min</div>
            </div>
          </div>
          <div class="flex items-center gap-3 text-sm">
            <span class="rounded-full bg-slate-200 px-2.5 py-1 font-semibold text-slate-700">${toNumber(edge.count).toLocaleString()} plays</span>
            <span class="rounded-full bg-indigo-100 px-2.5 py-1 font-semibold text-indigo-700">${(toNumber(edge.probability) * 100).toFixed(1)}%</span>
          </div>
        </div>
      `).join('');
    };

    const renderAll = () => {
      setScopeButtonState();
      updateScopeSummary();
      renderDetails();
      renderNetwork();
      renderFlowLadders();
      renderTopHandoffs();
    };

    const populateSourceControl = () => {
      if (!(sourceFilterEl instanceof HTMLSelectElement)) return;
      const options = Array.from(sourceFilterEl.options);
      options.forEach((option) => {
        option.disabled = !availableSources.includes(option.value);
      });
      if (!availableSources.includes(selectedSource)) {
        selectedSource = availableSources[0] || 'all';
      }
      sourceFilterEl.value = selectedSource;
    };

    const populateYearControl = (el, value) => {
      if (!(el instanceof HTMLSelectElement)) return;
      el.innerHTML = '';
      availableYears.forEach((year) => {
        const option = document.createElement('option');
        option.value = String(year);
        option.textContent = String(year);
        el.appendChild(option);
      });
      el.value = String(value);
    };

    const updateQueryLabel = () => {
      if (queryRangeLabelEl) {
        const source = sourceLabels[selectedSource] || selectedSource;
        queryRangeLabelEl.textContent = `${source} · ${selectedStartYear} to ${selectedEndYear}`;
      }
    };

    const updateQueryStatus = (text, tone = 'info') => {
      if (!queryStatusEl) return;
      queryStatusEl.textContent = text;
      queryStatusEl.classList.remove('border-sky-200', 'bg-sky-50', 'text-sky-800', 'border-amber-200', 'bg-amber-50', 'text-amber-800');
      if (tone === 'warn') {
        queryStatusEl.classList.add('border-amber-200', 'bg-amber-50', 'text-amber-800');
      } else {
        queryStatusEl.classList.add('border-sky-200', 'bg-sky-50', 'text-sky-800');
      }
    };

    const collectSlicesForCurrentRange = () => {
      if (!querySlices) return [];
      const slices = [];
      for (let year = selectedStartYear; year <= selectedEndYear; year += 1) {
        const key = `${selectedSource}/${year}`;
        if (querySlices[key]) slices.push(querySlices[key]);
      }
      return slices;
    };

    const applyCurrentQuery = () => {
      if (!Array.isArray(availableYears) || availableYears.length === 0) return;

      selectedStartYear = Math.max(availableYears[0], selectedStartYear);
      selectedEndYear = Math.min(availableYears[availableYears.length - 1], selectedEndYear);
      if (selectedStartYear > selectedEndYear) {
        selectedEndYear = selectedStartYear;
      }

      if (!querySlices) {
        activeNetworkPayload = networkPayload;
        activeFlowPayload = flowPayload;
        activeHandoffPayload = handoffPayload;
        updateQueryLabel();
        renderAll();
        return;
      }

      const slices = collectSlicesForCurrentRange();
      if (slices.length === 0) {
        activeNetworkPayload = { track: { summary: {}, nodes: [], edges: [] }, artist: { summary: {}, nodes: [], edges: [] } };
        activeFlowPayload = { track: [], artist: [] };
        activeHandoffPayload = { track: [], artist: [] };
      } else {
        const dataset = buildDatasetFromSlices(slices);
        activeNetworkPayload = dataset.network;
        activeFlowPayload = dataset.flow;
        activeHandoffPayload = dataset.handoffs;
      }

      selectedNodeId = '';
      updateQueryLabel();
      renderAll();
    };

    const syncFilterValuesFromControls = () => {
      if (sourceFilterEl instanceof HTMLSelectElement) {
        selectedSource = sourceFilterEl.value || selectedSource;
      }
      if (startYearEl instanceof HTMLSelectElement) {
        selectedStartYear = toNumber(startYearEl.value, selectedStartYear);
      }
      if (endYearEl instanceof HTMLSelectElement) {
        selectedEndYear = toNumber(endYearEl.value, selectedEndYear);
      }
      if (selectedStartYear > selectedEndYear) {
        selectedEndYear = selectedStartYear;
        if (endYearEl instanceof HTMLSelectElement) endYearEl.value = String(selectedEndYear);
      }
    };

    const initializeControls = () => {
      populateSourceControl();
      populateYearControl(startYearEl, selectedStartYear);
      populateYearControl(endYearEl, selectedEndYear);
      updateQueryLabel();

      if (applyQueryEl instanceof HTMLButtonElement) {
        applyQueryEl.addEventListener('click', () => {
          syncFilterValuesFromControls();
          applyCurrentQuery();
        });
      }

      if (resetQueryEl instanceof HTMLButtonElement) {
        resetQueryEl.addEventListener('click', () => {
          selectedSource = availableSources.includes('all') ? 'all' : availableSources[0];
          selectedStartYear = availableYears[0];
          selectedEndYear = availableYears[availableYears.length - 1];
          populateSourceControl();
          populateYearControl(startYearEl, selectedStartYear);
          populateYearControl(endYearEl, selectedEndYear);
          applyCurrentQuery();
        });
      }

      if (sourceFilterEl instanceof HTMLSelectElement) {
        sourceFilterEl.addEventListener('change', () => {
          selectedSource = sourceFilterEl.value;
          applyCurrentQuery();
        });
      }

      if (startYearEl instanceof HTMLSelectElement) {
        startYearEl.addEventListener('change', () => {
          selectedStartYear = toNumber(startYearEl.value, selectedStartYear);
          if (selectedStartYear > selectedEndYear) {
            selectedEndYear = selectedStartYear;
            if (endYearEl instanceof HTMLSelectElement) endYearEl.value = String(selectedEndYear);
          }
          applyCurrentQuery();
        });
      }

      if (endYearEl instanceof HTMLSelectElement) {
        endYearEl.addEventListener('change', () => {
          selectedEndYear = toNumber(endYearEl.value, selectedEndYear);
          if (selectedEndYear < selectedStartYear) {
            selectedStartYear = selectedEndYear;
            if (startYearEl instanceof HTMLSelectElement) startYearEl.value = String(selectedStartYear);
          }
          applyCurrentQuery();
        });
      }
    };

    const loadQueryCache = async () => {
      try {
        const response = await fetch(`${defaultDataRoot}/transition-query-cache.json`);
        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }
        const payload = await response.json();

        const years = Array.isArray(payload?.years)
          ? payload.years.map((year) => toNumber(year)).filter((year) => Number.isFinite(year))
          : [];
        years.sort((a, b) => a - b);

        const sources = Array.isArray(payload?.sources)
          ? payload.sources.filter((source) => typeof source === 'string')
          : [];

        if (!payload?.slices || typeof payload.slices !== 'object' || years.length === 0) {
          throw new Error('missing slices/years');
        }

        querySlices = payload.slices;
        availableYears = years;
        availableSources = sources.length ? sources : ['all'];
        selectedSource = availableSources.includes('all') ? 'all' : availableSources[0];
        selectedStartYear = availableYears[0];
        selectedEndYear = availableYears[availableYears.length - 1];

        const generatedAt = typeof payload.generatedAt === 'string' ? payload.generatedAt : '';
        updateQueryStatus(
          generatedAt
            ? `Loaded MCP query cache (${generatedAt}).`
            : 'Loaded MCP query cache.',
          'info'
        );
      } catch (error) {
        updateQueryStatus('MCP query cache unavailable; using full-range fallback slice.', 'warn');
        querySlices = null;
      }
    };

    scopeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const nextScope = button.getAttribute('data-scope');
        if (!nextScope || nextScope === currentScope) return;
        currentScope = nextScope;
        selectedNodeId = '';
        renderAll();
      });
    });

    const init = async () => {
      await loadQueryCache();
      initializeControls();
      applyCurrentQuery();
    };

    init();
  </script>
</Layout>
