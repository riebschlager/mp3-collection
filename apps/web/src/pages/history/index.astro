---
import Layout from '../../layouts/Layout.astro';

// Load timeline data
const timeline = await import('../../../public/data/timeline.json');

const buildUrl = (path: string) => {
  const base = import.meta.env.BASE_URL;
  const cleanPath = path.startsWith('/') ? path.slice(1) : path;
  const separator = base.endsWith('/') ? '' : '/';
  return `${base}${separator}${cleanPath}`;
};

const formatDate = (timestamp: number) => {
  return new Date(timestamp).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};

const formatMonth = (monthStr: string) => {
  const [year, month] = monthStr.split('-');
  const date = new Date(parseInt(year), parseInt(month) - 1);
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
};
---

<Layout title="Listening History - MP3 Collection">
  <div class="space-y-8">
    <!-- Header -->
    <div class="text-center">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">
        Listening History
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Explore {timeline.totalScrobbles.toLocaleString()} scrobbles from {formatDate(timeline.firstScrobble)} to {formatDate(timeline.lastScrobble)}
      </p>
    </div>

    <!-- Rediscovery Arcs -->
    <div class="rounded-2xl bg-gradient-to-br from-slate-900 via-indigo-900 to-slate-800 text-white p-8 shadow-xl">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5">
        <div>
          <p class="text-xs uppercase tracking-[0.25em] text-slate-300 mb-2">New Visualization</p>
          <h2 class="text-3xl font-bold">Rediscovery Arcs</h2>
          <p class="mt-2 text-slate-200 max-w-2xl">
            See tracks that disappeared for years and then came back, with each arc linking pre-return and return years.
          </p>
        </div>
        <a
          href={buildUrl('history/rediscovery')}
          class="inline-flex items-center justify-center rounded-full bg-white/15 px-6 py-3 text-sm font-semibold text-white hover:bg-white/25 transition-colors"
        >
          Open Rediscovery Arcs ->
        </a>
      </div>
    </div>

    <!-- Monthly Story Wall -->
    <div class="rounded-2xl bg-gradient-to-br from-emerald-900 via-cyan-900 to-slate-900 text-white p-8 shadow-xl">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5">
        <div>
          <p class="text-xs uppercase tracking-[0.25em] text-slate-300 mb-2">New Visualization</p>
          <h2 class="text-3xl font-bold">Monthly Story Wall</h2>
          <p class="mt-2 text-slate-200 max-w-2xl">
            Browse every month as a visual story tile, then drill into discovery, source mix, overlap, and risers/decliners.
          </p>
        </div>
        <a
          href={buildUrl('history/month-wall')}
          class="inline-flex items-center justify-center rounded-full bg-white/15 px-6 py-3 text-sm font-semibold text-white hover:bg-white/25 transition-colors"
        >
          Open Monthly Story Wall ->
        </a>
      </div>
    </div>

    <!-- Artist Bar Chart Race -->
    <div class="rounded-2xl bg-gradient-to-br from-stone-950 via-amber-900 to-emerald-900 text-white p-8 shadow-xl">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5">
        <div>
          <p class="text-xs uppercase tracking-[0.25em] text-amber-200 mb-2">New Visualization</p>
          <h2 class="text-3xl font-bold">Artist Bar Chart Race</h2>
          <p class="mt-2 text-stone-100 max-w-2xl">
            Follow the cumulative all-time artist leaderboard month by month and watch the archive’s long-term winners take shape.
          </p>
        </div>
        <a
          href={buildUrl('history/artist-race')}
          class="inline-flex items-center justify-center rounded-full bg-white/15 px-6 py-3 text-sm font-semibold text-white hover:bg-white/25 transition-colors"
        >
          Open Artist Race ->
        </a>
      </div>
    </div>

    <!-- Transition Flow Atlas -->
    <div class="rounded-2xl bg-gradient-to-br from-fuchsia-900 via-indigo-900 to-slate-900 text-white p-8 shadow-xl">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5">
        <div>
          <p class="text-xs uppercase tracking-[0.25em] text-slate-300 mb-2">New Visualization</p>
          <h2 class="text-3xl font-bold">Transition Flow Atlas</h2>
          <p class="mt-2 text-slate-200 max-w-2xl">
            Inspect your strongest within-session handoffs, from track-to-track tunnels to artist-to-artist corridors.
          </p>
        </div>
        <a
          href={buildUrl('history/transitions')}
          class="inline-flex items-center justify-center rounded-full bg-white/15 px-6 py-3 text-sm font-semibold text-white hover:bg-white/25 transition-colors"
        >
          Open Transition Atlas ->
        </a>
      </div>
    </div>

    <!-- Era Similarity Index -->
    <div class="rounded-2xl bg-gradient-to-br from-emerald-900 via-teal-800 to-amber-700 text-white p-8 shadow-xl">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5">
        <div>
          <p class="text-xs uppercase tracking-[0.25em] text-slate-200 mb-2">New Visualization</p>
          <h2 class="text-3xl font-bold">Era Similarity Index</h2>
          <p class="mt-2 text-slate-100 max-w-2xl">
            Compare every year against every other year with a weighted taste-similarity score and inspect what drives the match.
          </p>
        </div>
        <a
          href={buildUrl('history/era-similarity')}
          class="inline-flex items-center justify-center rounded-full bg-white/15 px-6 py-3 text-sm font-semibold text-white hover:bg-white/25 transition-colors"
        >
          Open Era Similarity ->
        </a>
      </div>
    </div>

    <!-- Obsession Timeline -->
    <div class="rounded-2xl bg-gradient-to-br from-purple-900 via-rose-900 to-amber-900 text-white p-8 shadow-xl">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5">
        <div>
          <p class="text-xs uppercase tracking-[0.25em] text-purple-300 mb-2">New Visualization</p>
          <h2 class="text-3xl font-bold">Obsession Timeline</h2>
          <p class="mt-2 text-rose-200 max-w-2xl">
            See your most intense listening bursts—the tracks you played repeatedly in a short span of days, sorted by burst heat.
          </p>
        </div>
        <a
          href={buildUrl('history/obsessions')}
          class="inline-flex items-center justify-center rounded-full bg-white/15 px-6 py-3 text-sm font-semibold text-white hover:bg-white/25 transition-colors"
        >
          Open Obsessions ->
        </a>
      </div>
    </div>

    <!-- Timeline Overview -->
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Timeline Overview</h2>
      <div class="space-y-8">
        {timeline.years.sort((a: any, b: any) => b.year - a.year).map((year: any) => (
          <div class="border-l-4 border-blue-500 pl-6">
            <div class="mb-4">
              <h3 class="text-2xl font-bold text-gray-900">{year.year}</h3>
              <div class="flex gap-6 mt-2 text-sm text-gray-600">
                <span>{year.totalScrobbles.toLocaleString()} scrobbles</span>
                <span>{year.uniqueTracks.toLocaleString()} unique tracks</span>
                <span>{year.months.length} active months</span>
              </div>
            </div>

            <!-- Top Tracks for Year -->
            <div class="mb-4">
              <h4 class="text-lg font-semibold text-gray-800 mb-3">Top Tracks of {year.year}</h4>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                {year.topTracks.slice(0, 10).map((track: any, index: number) => (
                  <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg">
                    <div class="flex-shrink-0 w-6 h-6 rounded-full bg-blue-600 text-white text-xs flex items-center justify-center font-bold">
                      {index + 1}
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="text-sm font-medium text-gray-900 truncate">{track.track}</div>
                      <div class="text-xs text-gray-600 truncate">{track.artist}</div>
                    </div>
                    <div class="flex-shrink-0">
                      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                        {track.playCount}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Monthly Breakdown -->
            <details class="group">
              <summary class="cursor-pointer text-blue-600 hover:text-blue-800 font-medium mb-3">
                View monthly breakdown ({year.months.length} months)
              </summary>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-4">
                {year.months.sort((a: any, b: any) => b.month.localeCompare(a.month)).map((month: any) => (
                  <div class="bg-gray-50 rounded-lg p-4">
                    <h5 class="font-semibold text-gray-900 mb-2">{formatMonth(month.month)}</h5>
                    <div class="text-sm text-gray-600 mb-3">
                      <div>{month.totalScrobbles} scrobbles</div>
                      <div>{month.uniqueTracks} unique tracks</div>
                    </div>
                    <div class="space-y-2">
                      <div class="text-xs font-medium text-gray-700 mb-1">Top Tracks:</div>
                      {month.topTracks.slice(0, 5).map((track: any, idx: number) => (
                        <div class="text-xs text-gray-600 flex justify-between">
                          <span class="truncate flex-1 mr-2">
                            <span class="text-gray-400">{idx + 1}.</span> {track.artist} - {track.track}
                          </span>
                          <span class="flex-shrink-0 font-medium text-blue-600">{track.playCount}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </details>
          </div>
        ))}
      </div>
    </div>

    <!-- Back to Home -->
    <div class="text-center">
      <a
        href={buildUrl('/')}
        class="inline-flex items-center px-6 py-3 border border-gray-300 shadow-sm text-base font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50"
      >
        ← Back to Home
      </a>
    </div>
  </div>
</Layout>
