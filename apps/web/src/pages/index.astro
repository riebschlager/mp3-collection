---
import Layout from '../layouts/Layout.astro';
import TrackList from '../components/TrackList.astro';

// Load metadata from JSON
const metadata = await import('../../public/data/metadata.json');

// Load first chunk of tracks
const firstChunk = await import('../../public/data/chunks/tracks-001.json');

// Load playcounts to show most played
const playcounts = await import('../../public/data/playcounts.json');
const mostPlayed = playcounts.playCounts.sort((a: any, b: any) => b.playCount - a.playCount).slice(0, 20);

const buildUrl = (path: string) => {
  const base = import.meta.env.BASE_URL;
  const cleanPath = path.startsWith('/') ? path.slice(1) : path;
  const separator = base.endsWith('/') ? '' : '/';
  return `${base}${separator}${cleanPath}`;
};




---

<Layout title="MP3 Collection - Historical iTunes Library">
  <div class="space-y-12">
    <!-- Hero Section -->
    <div class="text-center">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">
        Historical iTunes MP3 Collection
      </h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        A journey through {metadata.totalTracks?.toLocaleString()} tracks from the early 2000s,
        spanning {metadata.stats?.totalDurationFormatted} of music across
        {metadata.totalArtists?.toLocaleString()} artists and {metadata.totalAlbums?.toLocaleString()} albums.
      </p>
    </div>

    <!-- Statistics Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-white rounded-lg shadow p-6">
        <div class="text-3xl font-bold text-blue-600">{metadata.totalTracks?.toLocaleString()}</div>
        <div class="text-sm text-gray-600 mt-1">Total Tracks</div>
      </div>
      <div class="bg-white rounded-lg shadow p-6">
        <div class="text-3xl font-bold text-green-600">{metadata.totalArtists?.toLocaleString()}</div>
        <div class="text-sm text-gray-600 mt-1">Unique Artists</div>
      </div>
      <div class="bg-white rounded-lg shadow p-6">
        <div class="text-3xl font-bold text-purple-600">{metadata.totalAlbums?.toLocaleString()}</div>
        <div class="text-sm text-gray-600 mt-1">Albums</div>
      </div>
      <div class="bg-white rounded-lg shadow p-6">
        <div class="text-3xl font-bold text-orange-600">{metadata.stats?.totalSizeGB} GB</div>
        <div class="text-sm text-gray-600 mt-1">Total Size</div>
      </div>
    </div>

    <!-- Collection Insights -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Music Duration</h3>
        <p class="text-2xl font-bold text-blue-600">{metadata.stats?.totalDurationFormatted}</p>
        <p class="text-sm text-gray-600 mt-1">
          {Math.round(metadata.stats?.totalDurationSeconds / 86400)} days of continuous music
        </p>
      </div>
    </div>

    <!-- Wrapped Feature -->
    <div class="relative overflow-hidden">
      <a
        href={buildUrl('wrapped')}
        class="block bg-gradient-to-br from-pink-500 via-purple-600 to-indigo-600 text-white rounded-2xl shadow-2xl p-12 hover:from-pink-600 hover:via-purple-700 hover:to-indigo-700 transition-all transform hover:scale-[1.02]"
      >
        <div class="relative z-10">
          <div class="text-sm font-semibold tracking-wide uppercase mb-2 opacity-90">
            New Feature
          </div>
          <h3 class="text-4xl md:text-5xl font-bold mb-4">
            Your Years Wrapped
          </h3>
          <p class="text-lg md:text-xl text-pink-100 mb-6 max-w-2xl">
            Explore Spotify Wrapped-style presentations for each year of your listening history, from 2005 to 2026
          </p>
          <div class="inline-flex items-center gap-2 text-lg font-semibold">
            <span>Explore Your Music Journey</span>
            <span class="text-2xl">→</span>
          </div>
        </div>
        <div class="absolute inset-0 bg-gradient-to-br from-white/0 to-white/10" />
      </a>
    </div>

    <!-- Transition Atlas Feature -->
    <div class="relative overflow-hidden">
      <a
        href={buildUrl('history/transitions')}
        class="block bg-gradient-to-br from-fuchsia-700 via-indigo-700 to-cyan-700 text-white rounded-2xl shadow-2xl p-10 hover:from-fuchsia-800 hover:via-indigo-800 hover:to-cyan-800 transition-all transform hover:scale-[1.01]"
      >
        <div class="relative z-10">
          <div class="text-sm font-semibold tracking-wide uppercase mb-2 opacity-90">
            New Visualization
          </div>
          <h3 class="text-3xl md:text-4xl font-bold mb-3">
            Transition Flow Atlas
          </h3>
          <p class="text-base md:text-lg text-fuchsia-100 mb-5 max-w-3xl">
            Explore directional listening flows and session-based handoffs between tracks and artists.
          </p>
          <div class="inline-flex items-center gap-2 text-base font-semibold">
            <span>Open the Atlas</span>
            <span class="text-xl">→</span>
          </div>
        </div>
        <div class="absolute inset-0 bg-gradient-to-br from-white/0 to-white/10" />
      </a>
    </div>

    <!-- Quick Navigation -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <a
        href={buildUrl('artists')}
        class="bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-lg shadow-lg p-8 hover:from-blue-600 hover:to-blue-700 transition-all transform hover:scale-105"
      >
        <h3 class="text-2xl font-bold mb-2">Browse Artists</h3>
        <p class="text-blue-100">Explore {metadata.totalArtists?.toLocaleString()} artists</p>
      </a>
      <a
        href={buildUrl('albums')}
        class="bg-gradient-to-br from-green-500 to-green-600 text-white rounded-lg shadow-lg p-8 hover:from-green-600 hover:to-green-700 transition-all transform hover:scale-105"
      >
        <h3 class="text-2xl font-bold mb-2">Browse Albums</h3>
        <p class="text-green-100">Discover {metadata.totalAlbums?.toLocaleString()} albums</p>
      </a>
      <a
        href={buildUrl('tracks/1')}
        class="bg-gradient-to-br from-purple-500 to-purple-600 text-white rounded-lg shadow-lg p-8 hover:from-purple-600 hover:to-purple-700 transition-all transform hover:scale-105"
      >
        <h3 class="text-2xl font-bold mb-2">Browse Tracks</h3>
        <p class="text-purple-100">View all {metadata.totalTracks?.toLocaleString()} tracks</p>
      </a>
      <a
        href={buildUrl('history')}
        class="bg-gradient-to-br from-orange-500 to-orange-600 text-white rounded-lg shadow-lg p-8 hover:from-orange-600 hover:to-orange-700 transition-all transform hover:scale-105"
      >
        <h3 class="text-2xl font-bold mb-2">Listening History</h3>
        <p class="text-orange-100">Explore your Last.fm timeline</p>
      </a>
    </div>

    <!-- Most Played Tracks -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-gray-900">Most Played Tracks</h2>
        <a href={buildUrl('history')} class="text-blue-600 hover:text-blue-800 text-sm font-medium">
          View Full History →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {mostPlayed.map((track: any, index: number) => (
          <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 text-white text-sm flex items-center justify-center font-bold">
              {index + 1}
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-medium text-gray-900 truncate">{track.track}</div>
              <div class="text-xs text-gray-600 truncate">{track.artist}</div>
            </div>
            <div class="flex-shrink-0">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                {track.playCount} plays
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Genre Cloud -->
    {metadata.genres && metadata.genres.length > 0 && (
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Genres</h2>
        <div class="flex flex-wrap gap-2">
          {metadata.genres.slice(0, 50).map((genre: string) => (
            <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm">
              {genre}
            </span>
          ))}
          {metadata.genres.length > 50 && (
            <span class="px-3 py-1 bg-gray-200 text-gray-500 rounded-full text-sm">
              +{metadata.genres.length - 50} more
            </span>
          )}
        </div>
      </div>
    )}
  </div>
</Layout>
