---
/**
 * Wrapped Year Story - Slide-based presentation for a specific year
 */
import '../../styles/global.css';
import '../../styles/wrapped.css';
import { readFile } from 'node:fs/promises';
import { getTheme } from '../../lib/wrapped-themes';
import { getAvailableYears } from '../../lib/wrapped-utils';
import type { StoryCard, Track, WrappedStoriesData, YearData, YearStoryData } from '../../lib/wrapped-utils';

// Import slide components
import WelcomeSlide from '../../components/wrapped/slides/WelcomeSlide.astro';
import BigNumberSlide from '../../components/wrapped/slides/BigNumberSlide.astro';
import TopArtistSlide from '../../components/wrapped/slides/TopArtistSlide.astro';
import TopTracksSlide from '../../components/wrapped/slides/TopTracksSlide.astro';
import DiscoverySlide from '../../components/wrapped/slides/DiscoverySlide.astro';
import PatternSlide from '../../components/wrapped/slides/PatternSlide.astro';
import FunFactSlide from '../../components/wrapped/slides/FunFactSlide.astro';
import BadgesSlide from '../../components/wrapped/slides/BadgesSlide.astro';
import ThankYouSlide from '../../components/wrapped/slides/ThankYouSlide.astro';

// Load timeline data
const timelineData = await import('../../../public/data/timeline.json');
let wrappedStories: WrappedStoriesData | null = null;
try {
  const wrappedStoriesPath = new URL('../../../public/data/wrapped-stories.json', import.meta.url);
  const wrappedStoriesRaw = await readFile(wrappedStoriesPath, 'utf-8');
  wrappedStories = JSON.parse(wrappedStoriesRaw) as WrappedStoriesData;
} catch {
  wrappedStories = null;
}

// Generate static paths for all available years
export async function getStaticPaths() {
  const timelineData = await import('../../../public/data/timeline.json');
  const years = getAvailableYears(timelineData);

  return years.map((year: number) => ({
    params: { year: year.toString() },
  }));
}

// Get current year from params
const { year } = Astro.params;
const currentYear = parseInt(year);

// Get year data
const yearData = timelineData.years.find((y: any) => y.year === currentYear) as YearData;

if (!yearData) {
  return Astro.redirect('/wrapped');
}

const yearStory: YearStoryData | null = wrappedStories?.stories?.[String(currentYear)] ?? null;
const storyTopTracks: Track[] = Array.isArray(yearStory?.topTracks)
  ? yearStory.topTracks
      .filter((track) => typeof track.artist === 'string' && typeof track.track === 'string')
      .map((track) => ({
        track: track.track,
        artist: track.artist,
        album: '',
        playCount: typeof track.count === 'number' ? track.count : 0,
      }))
      .filter((track) => track.playCount > 0)
  : [];
const displayTopTracks = storyTopTracks.length > 0 ? storyTopTracks : yearData.topTracks;
const storySummary = yearStory?.summary;
const topArtist = yearStory?.topArtists?.[0];
const discoverySummary = yearStory?.discoveries?.summary;
const storyActiveDays = typeof storySummary?.activeDays === 'number' ? storySummary.activeDays : undefined;
const storyMinutes = typeof storySummary?.estimatedTotalMinutes === 'number'
  ? Math.round(storySummary.estimatedTotalMinutes)
  : undefined;
const storyNightShare = typeof storySummary?.nightPlayShare === 'number'
  ? storySummary.nightPlayShare
  : undefined;
const storyPeakDay = yearStory?.streaksAndBursts?.topBurstDays?.[0];
const storyInsightBullets = Array.isArray(yearStory?.insightBullets) ? yearStory.insightBullets : [];
const storyCards: StoryCard[] = Array.isArray(yearStory?.storyCards) ? yearStory.storyCards : [];
const recapTotalScrobbles = typeof storySummary?.totalScrobbles === 'number'
  ? storySummary.totalScrobbles
  : yearData.totalScrobbles;
const recapUniqueTracks = typeof storySummary?.uniqueTracks === 'number'
  ? storySummary.uniqueTracks
  : yearData.uniqueTracks;
const firstMonthKey = yearData.months?.[0]?.month;

// Get theme for this year
const theme = getTheme(currentYear);

// Get all years for navigation
const allYears = getAvailableYears(timelineData);
const currentIndex = allYears.indexOf(currentYear);
const nextYear = currentIndex < allYears.length - 1 ? allYears[currentIndex + 1] : undefined;
const prevYear = currentIndex > 0 ? allYears[currentIndex - 1] : undefined;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your {currentYear} Wrapped</title>
  </head>
  <body class="overflow-hidden">
    <div class={`wrapped-container bg-gradient-to-br ${theme.gradient} text-white`}>
      <!-- Slide 1: Welcome -->
      <div class="wrapped-slide">
        <WelcomeSlide year={currentYear} totalScrobbles={yearData.totalScrobbles} />
      </div>

      <!-- Slide 2: Big Number -->
      <div class="wrapped-slide">
        <BigNumberSlide
          totalScrobbles={yearData.totalScrobbles}
          totalMinutes={storyMinutes}
          activeDays={storyActiveDays}
        />
      </div>

      <!-- Slide 3: Top Artist -->
      {displayTopTracks.length > 0 && (
        <div class="wrapped-slide">
          <TopArtistSlide topTracks={displayTopTracks} topArtist={topArtist} />
        </div>
      )}

      <!-- Slide 4: Top 5 Tracks -->
      {displayTopTracks.length >= 5 && (
        <div class="wrapped-slide">
          <TopTracksSlide topTracks={displayTopTracks} />
        </div>
      )}

      <!-- Slide 5: Discovery -->
      <div class="wrapped-slide">
        <DiscoverySlide
          uniqueTracks={yearData.uniqueTracks}
          totalScrobbles={yearData.totalScrobbles}
          newArtistCount={discoverySummary?.newArtistCount}
          newTrackCount={discoverySummary?.newTrackCount}
        />
      </div>

      <!-- Slide 6: Listening Patterns -->
      {yearData.months && yearData.months.length > 0 && (
        <div class="wrapped-slide">
          <PatternSlide months={yearData.months} nightPlayShare={storyNightShare} peakDay={storyPeakDay} />
        </div>
      )}

      <!-- Slide 7: Fun Fact -->
      <div class="wrapped-slide">
        <FunFactSlide yearData={yearData} insightBullets={storyInsightBullets} storyCards={storyCards} />
      </div>

      <!-- Slide 8: Badges -->
      <div class="wrapped-slide">
        <BadgesSlide yearData={yearData} storyCards={storyCards} />
      </div>

      <!-- Slide 9: Thank You -->
      <div class="wrapped-slide">
        <ThankYouSlide
          year={currentYear}
          totalScrobbles={recapTotalScrobbles}
          uniqueTracks={recapUniqueTracks}
          nextYear={nextYear}
          prevYear={prevYear}
          monthlyMonthKey={firstMonthKey}
        />
      </div>
    </div>

    <!-- Intersection Observer Script -->
    <script>
      // Intersection Observer for triggering slide animations
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        {
          threshold: 0.3,
        }
      );

      // Observe all slide content
      document.querySelectorAll('.slide-content').forEach((el) => {
        observer.observe(el);
      });

      // Keyboard navigation
      document.addEventListener('keydown', (e) => {
        const container = document.querySelector('.wrapped-container');
        if (!container) return;

        const slideHeight = window.innerHeight;
        const currentScroll = container.scrollTop;

        if (e.key === 'ArrowDown' || e.key === ' ') {
          e.preventDefault();
          container.scrollTo({
            top: currentScroll + slideHeight,
            behavior: 'smooth',
          });
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          container.scrollTo({
            top: currentScroll - slideHeight,
            behavior: 'smooth',
          });
        }
      });
    </script>
  </body>
</html>
