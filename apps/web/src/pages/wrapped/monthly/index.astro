---
/**
 * Wrapped Monthly Gallery - Month selection page
 */
import { readFile } from 'node:fs/promises';
import '../../../styles/wrapped.css';
import Layout from '../../../layouts/Layout.astro';
import { buildUrl } from '../../../lib/urls';
import { formatMonth, type WrappedMonthStoriesData } from '../../../lib/wrapped-utils';
import { getTheme } from '../../../lib/wrapped-themes';

const timelineData = await import('../../../../public/data/timeline.json');
let monthStories: WrappedMonthStoriesData | null = null;
try {
  const monthStoriesPath = new URL('../../../../public/data/wrapped-month-stories.json', import.meta.url);
  const monthStoriesRaw = await readFile(monthStoriesPath, 'utf-8');
  monthStories = JSON.parse(monthStoriesRaw) as WrappedMonthStoriesData;
} catch {
  monthStories = null;
}

type MonthEntry = {
  key: string;
  year: number;
  month: string;
  label: string;
  totalScrobbles: number;
  uniqueTracks: number;
};

const monthEntries: MonthEntry[] = [];
for (const yearData of timelineData.years) {
  for (const monthData of yearData.months) {
    const monthKey = monthData.month;
    const storySummary = monthStories?.stories?.[monthKey]?.summary;
    monthEntries.push({
      key: monthKey,
      year: yearData.year,
      month: monthKey.slice(5, 7),
      label: formatMonth(monthKey),
      totalScrobbles: typeof storySummary?.totalScrobbles === 'number' ? storySummary.totalScrobbles : monthData.totalScrobbles,
      uniqueTracks: typeof storySummary?.uniqueTracks === 'number' ? storySummary.uniqueTracks : monthData.uniqueTracks,
    });
  }
}

monthEntries.sort((a, b) => b.key.localeCompare(a.key));

const grouped = new Map<number, MonthEntry[]>();
for (const month of monthEntries) {
  const existing = grouped.get(month.year);
  if (existing) {
    existing.push(month);
  } else {
    grouped.set(month.year, [month]);
  }
}
const years = Array.from(grouped.keys()).sort((a, b) => b - a);
---

<Layout title="Your Months Wrapped">
  <div class="min-h-screen bg-gradient-to-br from-slate-950 via-indigo-950 to-zinc-950 text-white py-12 px-4">
    <div class="max-w-7xl mx-auto">
      <header class="text-center mb-12">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold mb-4">
          Your Months Wrapped
        </h1>
        <p class="text-xl md:text-2xl opacity-90">
          Explore your listening month by month
        </p>
        {monthEntries.length > 0 && (
          <p class="text-lg opacity-75 mt-2">
            From {formatMonth(monthEntries[monthEntries.length - 1].key)} to {formatMonth(monthEntries[0].key)}
          </p>
        )}
      </header>

      <div class="text-center mb-10">
        <a
          href={buildUrl('wrapped')}
          class="inline-block px-6 py-3 rounded-full bg-white/15 backdrop-blur-sm font-medium hover:bg-white/25 transition-colors"
        >
          Back to yearly wrapped
        </a>
      </div>

      <div class="space-y-12">
        {years.map((year) => {
          const theme = getTheme(year);
          const months = grouped.get(year) || [];
          return (
            <section>
              <h2 class="text-3xl md:text-4xl font-bold mb-6">{year}</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                {months.map((entry) => (
                  <a href={buildUrl(`wrapped/monthly/${entry.year}/${entry.month}`)} class="year-card block group">
                    <div class={`relative overflow-hidden rounded-2xl shadow-2xl bg-gradient-to-br ${theme.gradient} p-6 min-h-48 flex flex-col justify-between transition-transform hover:scale-[1.03]`}>
                      <div>
                        <div class="text-sm font-medium opacity-80 mb-2">
                          {entry.key}
                        </div>
                        <h3 class="text-2xl md:text-3xl font-bold leading-tight">
                          {entry.label}
                        </h3>
                      </div>
                      <div class="space-y-2 text-sm">
                        <div class="flex justify-between items-center">
                          <span class="opacity-75">Scrobbles</span>
                          <span class="font-bold text-base">{entry.totalScrobbles.toLocaleString()}</span>
                        </div>
                        <div class="flex justify-between items-center">
                          <span class="opacity-75">Unique Tracks</span>
                          <span class="font-bold text-base">{entry.uniqueTracks.toLocaleString()}</span>
                        </div>
                      </div>
                      <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors" />
                    </div>
                  </a>
                ))}
              </div>
            </section>
          );
        })}
      </div>
    </div>
  </div>
</Layout>
