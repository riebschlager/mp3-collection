---
import Layout from '../../layouts/Layout.astro';
import { buildUrl } from '../../lib/urls';

const libraryUrl = buildUrl('library');
---

<Layout title="Tracks - MP3 Collection" description="Redirecting to the library browser">
  <section class="route-redirect">
    <p>Track browsing now lives in the unified library browser.</p>
    <a href={libraryUrl}>Open Library</a>
  </section>

  <script is:inline define:vars={{ libraryUrl }}>
    window.location.replace(libraryUrl);
  </script>
</Layout>

<style>
  .route-redirect {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding: 2rem;
    border-radius: 18px;
    background: rgba(255, 252, 246, 0.9);
    border: 1px solid rgba(76, 95, 117, 0.12);
  }

  .route-redirect a {
    color: #1f6f8b;
    font-weight: 600;
  }
</style>
